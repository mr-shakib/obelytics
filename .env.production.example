# Copy to .env.production on the VPS and fill in every value. Never commit the real file.

# Public domain served by host nginx. No scheme, no trailing slash.
DOMAIN=obelytics.bitstreamhq.com

# Application
# openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL (container-internal; not exposed to the internet)
POSTGRES_DB=obelytics
POSTGRES_USER=obelytics
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Redis (container-internal)
# openssl rand -hex 24
REDIS_PASSWORD=

# Connection pool per gunicorn worker (2 workers)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3

# Cloudinary (file storage)
CLOUDINARY_CLOUD_NAME=h1gsnk4q
CLOUDINARY_UPLOAD_PRESET=obelytics
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend) — optional
RESEND_API_KEY=
EMAIL_FROM=Obelytics <noreply@yourdomain.com>

# OBE Copilot (DeepSeek) — optional
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Frontend
NEXT_PUBLIC_APP_NAME=Obelytics

# Host ports (bound to 127.0.0.1) that nginx proxies to
BACKEND_PORT=8320
FRONTEND_PORT=3320
