# Copy to .env and fill in values

# Application
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=obelytics
POSTGRES_USER=obelytics
POSTGRES_PASSWORD=obelytics_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=redis_dev

# Cloudinary (file storage — https://cloudinary.com)
# API key/secret are optional; only needed if you use delete_object
CLOUDINARY_CLOUD_NAME=h1gsnk4q
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=obelytics

# CORS (JSON array)
ALLOWED_ORIGINS=["http://localhost:3000"]

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Obelytics <noreply@yourdomain.com>

# ── AI gateway: every model call goes through it (app/modules/ai) ────────────
# "local"  = an Ollama server you run — data stays on your servers
# "hosted" = any OpenAI-compatible API (DeepSeek, OpenAI, vLLM…) — personal data
#            is redacted before sending. Each organization can override these
#            defaults per feature on the AI Settings page.
AI_INTEGRITY_PROVIDER=local
AI_COPILOT_PROVIDER=hosted

AI_LOCAL_BASE_URL=http://localhost:11434
AI_LOCAL_TEXT_MODEL=qwen3.5:4b
AI_LOCAL_VISION_MODEL=qwen3.5:4b
AI_LOCAL_CHAT_MODEL=qwen3.5:4b

# Hosted provider. Example for DeepSeek (no vision model, JSON mode only):
#   AI_HOSTED_BASE_URL=https://api.deepseek.com  AI_HOSTED_TEXT_MODEL=deepseek-v4-flash
#   AI_HOSTED_CHAT_MODEL=deepseek-v4-flash      AI_HOSTED_JSON_MODE=json_object
#   AI_HOSTED_EXTRA_BODY={"thinking": {"type": "disabled"}}
AI_HOSTED_BASE_URL=
AI_HOSTED_API_KEY=
AI_HOSTED_TEXT_MODEL=
AI_HOSTED_VISION_MODEL=
AI_HOSTED_CHAT_MODEL=
AI_HOSTED_JSON_MODE=json_schema
# Prices for the usage page's cost estimate (USD per million tokens)
AI_HOSTED_INPUT_USD_PER_MTOK=0
AI_HOSTED_OUTPUT_USD_PER_MTOK=0

# Deprecated: still used for the hosted provider when AI_HOSTED_API_KEY is empty
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
COPILOT_MAX_OUTPUT_TOKENS=2048

# ── Assessment integrity auditor ─────────────────────────────────────────────
# inline: reading and audits run inside the API process (local development).
# arq:    the background worker runs them (production; start `arq app.workers.settings.WorkerSettings`).
INTEGRITY_JOB_RUNNER=inline
# Independent AI judgments per question; confidence is how often they agree.
INTEGRITY_AUDIT_SAMPLES=3
# Optional: calibration file produced by scripts/integrity_gold_set.py score
INTEGRITY_CALIBRATION_FILE=
